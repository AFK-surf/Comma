# Optional: the default instance binds only to loopback.
# Public Web/Admin/Product API origins must use HTTPS and one registrable domain.
# Example: https://app.example.com, https://admin.example.com, https://api.example.com.
# Cross-site browser/API origins are not supported by the SameSite=Lax session Cookie.
COMMA_PUBLIC_URL=http://localhost:8080
COMMA_API_URL=http://localhost:8081
COMMA_ADMIN_URL=http://localhost:8082
COMMA_SALIX_URL=http://localhost:4000

# For public hosting, create the first account and keep public signup off.
COMMA_OWNER_EMAIL=
COMMA_ALLOW_SIGNUP=false

# Supply an instance model, or configure a private model after login.
COMMA_LLM_BASE_URL=https://api.openai.com/v1
COMMA_LLM_PROTOCOL=chat_completions
COMMA_LLM_MODEL=gpt-4.1
COMMA_LLM_API_KEY=
COMMA_LLM_MAX_TOKENS=8192
COMMA_LLM_CONTEXT_TOKENS=128000
COMMA_EXA_API_KEY=

# Local login codes arrive at http://localhost:8025.
# For public hosting, set a real SMTP server and sender.
COMMA_SMTP_HOST=mailpit
COMMA_SMTP_PORT=1025
COMMA_SMTP_FROM=comma@localhost
COMMA_SMTP_USERNAME=
COMMA_SMTP_PASSWORD=
COMMA_SMTP_TLS=never
COMMA_SMTP_SSL=false
