<?xml version="1.0" encoding="utf-8"?>
<!-- A white pill on the near-white canvas needs an edge, and Nothing does not do
     shadows, so the edge is a hairline stroke. Pressed is a fill shift, not a
     ripple: the rest of this app has no ripples either.
     The radius is deliberately larger than any chip can be tall, so the pill stays
     a pill at every font scale; Skia scales the radii down to fit. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/chip_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/chip_stroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/card_white" />
            <stroke
                android:width="1dp"
                android:color="@color/chip_stroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
