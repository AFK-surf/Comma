    <color name="token_bg_primary">#0F0F10</color>
    <color name="token_bg_secondary">#18191B</color>
    <color name="token_bg_tertiary">#27282B</color>
    <color name="token_bg_quaternary">#343538</color>
    <color name="token_bg_brand_solid">#3B7CFF</color>
    <color name="token_bg_brand_solid_hover">#1040F2</color>
    <color name="token_bg_overlay">#27282B</color>
    <color name="token_text_primary">#F6F6F6</color>
    <color name="token_text_secondary">#D1D1D1</color>
    <color name="token_text_tertiary">#A4A5A9</color>
