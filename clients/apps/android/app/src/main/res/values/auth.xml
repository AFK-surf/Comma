<resources>
    <style name="Theme.Comma.Auth" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/token_bg_brand_solid</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/token_bg_primary</item>
        <item name="colorOnSurface">@color/token_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/token_text_secondary</item>
        <item name="colorOutline">@color/token_border_primary</item>
        <item name="colorError">@color/token_text_error_primary</item>
        <item name="android:fontFamily">@font/inter_variable</item>
        <item name="fontFamily">@font/inter_variable</item>
        <item name="android:windowBackground">@color/token_bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/auth_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/auth_light_bars</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="textInputStyle">@style/Widget.Comma.AuthInput</item>
    </style>
    <style name="Widget.Comma.AuthInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/token_bg_quaternary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxStrokeColor">@color/auth_input_stroke</item>
    </style>
    <bool name="auth_light_bars">true</bool>
    <item name="auth_email" type="id" />
    <item name="auth_code" type="id" />
    <item name="auth_primary" type="id" />
    <item name="auth_google" type="id" />
    <string name="auth_welcome_title">欢迎使用 Comma</string>
    <string name="auth_welcome_subtitle">随时随地，和你的 agent 一起工作</string>
    <string name="auth_email">邮箱</string>
    <string name="auth_email_placeholder">你的邮箱地址</string>
    <string name="auth_continue_email">用邮箱继续</string>
    <string name="auth_check_email_title">查看你的邮箱</string>
    <string name="auth_code_sent_to">验证码已发送到</string>
    <string name="auth_change">修改</string>
    <string name="auth_change_email">修改邮箱</string>
    <string name="auth_code">6 位验证码</string>
    <string name="auth_code_not_received">没收到？</string>
    <string name="auth_resend">重新发送</string>
    <plurals name="auth_resend_countdown"><item quantity="other">重新发送（%1$d 秒）</item></plurals>
    <plurals name="auth_resend_seconds"><item quantity="other">%1$d 秒后可重新发送</item></plurals>
    <plurals name="auth_retry_seconds"><item quantity="other">%1$d 秒后重试</item></plurals>
    <string name="auth_login">登录</string>
    <string name="auth_busy">请稍候</string>
    <string name="auth_switch_account">切换账号</string>
    <string name="auth_logout">退出登录</string>
    <string name="auth_retry">重试</string>
    <string name="auth_connecting_title">正在连接</string>
    <string name="auth_checking">正在验证登录状态…</string>
    <string name="auth_connecting">正在连接工作区…</string>
    <string name="auth_provisioning">正在准备你的工作区…</string>
    <string name="auth_connected">已连接到 %1$s</string>
    <string name="auth_connected_description">你的工作区已准备好。</string>
    <string name="auth_main_chat">主聊天 id：%1$s</string>
    <string name="auth_unconfigured_title">暂时无法登录</string>
    <string name="auth_unconfigured">服务地址尚未配置。</string>
    <string name="auth_retry_title">暂时无法连接</string>
    <string name="auth_storage_title">无法读取登录状态</string>
    <string name="auth_network_error">网络连接失败，请检查网络后重试。</string>
    <string name="auth_service_unavailable">服务暂时不可用，请稍后重试。</string>
    <string name="auth_rate_limited">请求较频繁，请等待倒计时结束。</string>
    <string name="auth_invalid_code">验证码错误或已过期，请重新输入或获取验证码。</string>
    <string name="auth_server_error">连接未完成，请稍后重试。</string>
    <string name="auth_storage_error">无法读取或保存登录状态。请重试，或切换账号重新登录。</string>
    <string name="auth_no_workspace">暂时没有可用的工作区，请稍后重试。</string>
    <string name="auth_invalid_email">请输入有效的邮箱地址</string>
    <!-- Google 登录。按钮文案沿用 Google 品牌规范推荐的 "Continue with Google"。 -->
    <string name="auth_continue_google">用 Google 账号继续</string>
    <string name="auth_google_busy">正在用 Google 账号登录</string>
    <string name="auth_or">或</string>
    <string name="auth_google_link_sent_to">为关联 Google 账号，请输入发送到以下邮箱的验证码</string>
    <string name="auth_back">返回</string>
    <string name="auth_back_to_sign_in">返回选择登录方式</string>
    <string name="auth_account_disabled">此账号已停用。</string>
    <string name="auth_google_not_configured">暂时还不能用 Google 账号登录，请先用邮箱登录。</string>
    <string name="auth_google_no_account">这台设备上没有 Google 账号。可以在系统设置中添加，或用邮箱登录。</string>
    <string name="auth_google_unavailable">这台设备没有 Google Play 服务，无法用 Google 账号登录，请用邮箱登录。</string>
    <string name="auth_google_rejected">没能通过 Google 验证你的账号，请重试或用邮箱登录。</string>
    <string name="auth_google_conflict">这个 Google 账号不能用来登录，请用邮箱登录。</string>
</resources>
