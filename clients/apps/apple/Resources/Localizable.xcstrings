    "devices_add_code_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If %@ shows a 6-digit code, your phone asks for it in a pairing request. If the request shows up as a notification, tap Pair & connect, then type the code. A device without a screen pairs on its own; accept the request if your phone shows one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 %@ 的屏幕上显示 6 位配对码，手机会弹出配对请求让你输入。如果配对请求出现在通知里，先点「Pair & connect」（配对并连接），再输入配对码。没有屏幕的设备会自动完成配对，如果手机弹出配对请求，确认即可。"
          }
        }
      }
    },
