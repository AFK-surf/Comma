    "settings_voice_custom_dialog_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the voice you want. It replaces the previous custom voice and is used for calls at once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述你想要的声音。生成后会替换之前的自定义音色，并立即用于通话。"
          }
        }
      }
    },
    "settings_voice_custom_none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a voice from a description: gender, age, accent, tone and pace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一段描述生成一个音色，比如性别、年龄、口音、语气和语速。"
          }
        }
      }
    },
