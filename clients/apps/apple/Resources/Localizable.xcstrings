    "settings_voice_keys_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voice agent API key lets a voice client, such as the comma-voice command, talk to the assistant. The key cannot send messages or read data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音 Agent API key 允许语音客户端（例如 comma-voice 命令）与助手通话。这个 key 不能发送消息，也不能读取数据。"
          }
        }
      }
    },
    "settings_voice_keys_none": {
      "extractionState": "manual",
      "localizations": {
