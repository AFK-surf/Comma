      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your mobile number with + and its country code. We send a code by SMS to confirm that the number is yours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入带 + 和国家代码的手机号码。我们会发送短信验证码，确认这个号码属于你。"
          }
        }
      }
    },
