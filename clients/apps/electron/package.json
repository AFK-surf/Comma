{
  "name": "@comma/electron",
  "private": true,
  "version": "0.0.1",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "pnpm build:native --incremental && tsx ./scripts/install-dev-protocol-handler.ts && electron-forge start",
    "dev:protocol": "tsx ./scripts/install-dev-protocol-handler.ts",
    "build": "pnpm build:native && electron-forge package",
    "build:native": "tsx ./scripts/build-native.ts",
    "build:native:airdrop": "tsx ./scripts/build-native.ts --airdrop-only",
    "pin:opendropkit": "tsx ./scripts/pin-opendropkit-release.ts",
    "build:native:notification-authorization": "tsx ./scripts/build-native.ts --notification-authorization-only",
    "build:native:cable-scanner": "tsx ./scripts/build-native.ts --cable-scanner-only",
    "build:native:menu-bar": "tsx ./scripts/build-native.ts --menu-bar-only",
    "build:native:synch": "tsx ./scripts/build-native.ts --synch-only",
    "pack:velopack": "tsx ./scripts/pack-velopack.ts",
    "release:version:staging": "tsx ./scripts/resolve-staging-release-version.ts",
    "release:velopack": "tsx ./scripts/download-release-feed.ts && NODE_ENV=production pnpm build:native && electron-forge package && tsx ./scripts/sign-macos-app.ts && tsx ./scripts/release-velopack.ts",
    "release:velopack:prod": "COMMA_BUILD_FLAVOR=prod pnpm release:velopack",
    "release:velopack:staging": "COMMA_BUILD_FLAVOR=staging pnpm release:velopack"
  },
  "dependencies": {
    "@comma/app": "workspace:*",
    "@comma/chat-contract": "workspace:*",
    "@comma/config": "workspace:*",
    "@comma/core": "workspace:*",
    "@comma/core-kernel": "workspace:*",
    "@comma/core-client": "workspace:*",
    "@comma/i18n": "workspace:*",
    "@comma/mesh": "workspace:*",
    "@comma/native-bridge": "workspace:*",
    "@comma/session-contract": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@noble/hashes": "^2.4.0",
    "@recappi/sdk": "^1.2.0",
    "cborg": "^6.1.3",
    "electron-log": "^5.4.4",
    "extract-zip": "2.0.1",
    "oauth4webapi": "3.8.6",
    "openid-client": "6.8.4",
    "protobufjs": "^7.6.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tldts": "^7.4.3",
    "velopack": "^1.2.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/get": "3.1.0",
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.4.0",
    "@electron/packager": "18.4.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
