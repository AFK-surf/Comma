{
  "name": "@comma/electron",
  "private": true,
  "version": "0.0.1",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "pnpm build:native && tsx ./scripts/install-dev-protocol-handler.ts && electron-forge start",
    "dev:protocol": "tsx ./scripts/install-dev-protocol-handler.ts",
    "build": "pnpm build:native && electron-forge package",
    "build:native": "tsx ./scripts/build-native.ts",
    "build:native:airdrop": "tsx ./scripts/build-native.ts --airdrop-only",
    "pin:opendropkit": "tsx ./scripts/pin-opendropkit-release.ts",
    "build:native:notification-authorization": "tsx ./scripts/build-native.ts --notification-authorization-only",
    "build:native:side-chat": "tsx ./scripts/build-native.ts --side-chat-only",
    "build:native:synch": "tsx ./scripts/build-native.ts --synch-only",
    "profile:inbox-runtime": "COMMA_SKIP_NATIVE_BUILD=1 pnpm build && node --no-warnings --experimental-strip-types ./scripts/profile-inbox-runtime.ts",
    "profile:inbox-runtime:self-test": "node --no-warnings --experimental-strip-types ./scripts/profile-inbox-runtime.ts --self-test",
    "profile:local-data": "COMMA_SKIP_NATIVE_BUILD=1 pnpm build && pnpm profile:local-data:bundle && electron --no-warnings ./.vite/profile/profile-local-data.mjs",
    "profile:local-data:bundle": "vite build --config ./scripts/vite.profile-local-data.config.ts",
    "profile:local-data:self-test": "ELECTRON_RUN_AS_NODE=1 electron --no-warnings --experimental-strip-types ./scripts/profile-local-data.mjs --self-test",
    "pack:velopack": "tsx ./scripts/pack-velopack.ts",
    "release:version:staging": "tsx ./scripts/resolve-staging-release-version.ts",
    "release:velopack": "tsx ./scripts/download-release-feed.ts && NODE_ENV=production pnpm build:native && electron-forge package && tsx ./scripts/sign-macos-app.ts && tsx ./scripts/release-velopack.ts",
    "release:velopack:prod": "COMMA_BUILD_FLAVOR=prod pnpm release:velopack",
    "release:velopack:staging": "COMMA_BUILD_FLAVOR=staging pnpm release:velopack"
  },
  "dependencies": {
    "@comma/app": "workspace:*",
    "@comma/chat-contract": "workspace:*",
    "@comma/config": "workspace:*",
    "@comma/i18n": "workspace:*",
    "@comma/native-bridge": "workspace:*",
    "@comma/product-inbox-runtime": "workspace:*",
    "@comma/session-contract": "workspace:*",
    "@comma/session-history-runtime": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@noble/hashes": "^2.4.0",
    "@recappi/sdk": "^1.2.0",
    "async-call-rpc": "^6.4.2",
    "electron-log": "^5.4.4",
    "eventsource-parser": "4.1.0",
    "extract-zip": "2.0.1",
    "oauth4webapi": "3.8.6",
    "openid-client": "6.8.4",
    "protobufjs": "^7.6.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "velopack": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.4.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
