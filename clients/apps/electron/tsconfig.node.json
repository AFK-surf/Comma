{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../../node_modules/.tmp/tsconfig.electron.node.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@comma/app": ["../../packages/app/src/index.tsx"],
      "@comma/config": ["../../packages/config/src/index.ts"],
      "@comma/native-bridge": ["../../packages/native-bridge/src/index.ts"],
      "@comma/session-contract": ["../../packages/session-contract/src/index.ts"],
      "@comma/ui": ["../../packages/ui/src/index.ts"],
      "@comma/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "forge.config.ts",
    "vite.*.config.ts",
    "scripts/**/*.ts",
    "native/macos/SleepGuard/index.ts",
    "src/app-version.ts",
    "src/release-config.ts",
    "src/test-support/electron-window.ts",
    "../../vite/*.ts"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.spec.*",
    "../../packages/**/*.test.*",
    "../../packages/**/*.spec.*"
  ],
  "references": [
    {
      "path": "../../packages/chat-contract"
    },
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/i18n"
    },
    {
      "path": "../../packages/layout-inspector"
    },
    {
      "path": "../../packages/native-bridge"
    },
    {
      "path": "../../packages/session-contract"
    },
    {
      "path": "../../packages/i18n/tsconfig.tools.json"
    },
    {
      "path": "../../packages/layout-inspector/tsconfig.tools.json"
    }
  ]
}
