{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "main": "./wrangler.worker.ts",
  "account_id": "0367b0648b476f564267fd6f4c2d515e",
  "compatibility_date": "2026-06-17",
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "app.comma.surf",
      "custom_domain": true,
    },
  ],
  "env": {
    "staging": {
      "routes": [
        {
          "pattern": "app-staging.comma.surf",
          "custom_domain": true,
        },
      ],
    },
  },
}
