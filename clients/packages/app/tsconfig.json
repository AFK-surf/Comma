{
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../../node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": ["vite/client"],
    "rootDir": "../..",
    "outDir": "dist",
    "paths": {
      "@comma/config": ["../config/src/index.ts"],
      "@comma/i18n": ["../i18n/src/index.ts"],
      "@comma/i18n/react": ["../i18n/src/react.tsx"],
      "@comma/layout-inspector": ["../layout-inspector/src/index.ts"],
      "@comma/native-bridge": ["../native-bridge/src/index.ts"],
      "@comma/session-contract": ["../session-contract/src/index.ts"],
      "@comma/ui": ["../ui/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../config/src/**/*.ts",
    "../i18n/src/**/*.ts",
    "../i18n/src/**/*.tsx",
    "../layout-inspector/src/**/*.ts",
    "../layout-inspector/src/**/*.tsx",
    "../native-bridge/src/**/*.ts",
    "../session-contract/src/**/*.ts",
    "../ui/src/**/*.ts",
    "../ui/src/**/*.tsx",
    "../ui/src/**/*.json"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.spec.*",
    "../layout-inspector/**/*.test.*",
    "../layout-inspector/**/*.spec.*",
    "../native-bridge/**/*.test.*",
    "../native-bridge/**/*.spec.*",
    "../session-contract/**/*.test.*",
    "../session-contract/**/*.spec.*",
    "../ui/**/*.test.*",
    "../ui/**/*.spec.*"
  ]
}
