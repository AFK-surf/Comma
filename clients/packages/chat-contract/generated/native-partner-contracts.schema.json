{
  "$defs": {
    "CommaNotchScenePayload": {
      "properties": {
        "airDrop": {
          "properties": {
            "transfer": {
              "properties": {
                "acceptLabel": {
                  "maxLength": 64,
                  "type": "string"
                },
                "declineLabel": {
                  "maxLength": 64,
                  "type": "string"
                },
                "phase": {
                  "enum": ["offer", "receiving", "completed", "failed"],
                  "type": "string"
                },
                "preview": {
                  "maxLength": 700000,
                  "type": "string"
                },
                "progress": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "requestId": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "subtitle": {
                  "maxLength": 512,
                  "type": "string"
                },
                "title": {
                  "maxLength": 256,
                  "type": "string"
                }
              },
              "required": ["phase", "requestId", "title"],
              "type": "object"
            }
          },
          "type": "object"
        },
        "compactSideWidth": {
          "maximum": 240,
          "minimum": 32,
          "type": "integer"
        },
        "detail": {
          "type": "string"
        },
        "hasActivity": {
          "type": "boolean"
        },
        "listSubtitle": {
          "maxLength": 2048,
          "type": "string"
        },
        "listTitle": {
          "maxLength": 256,
          "type": "string"
        },
        "notify": {
          "type": "boolean"
        },
        "openChatLabel": {
          "maxLength": 128,
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "tasks": {
          "items": {
            "properties": {
              "conversationId": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "groupId": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "enum": ["in_progress", "failed", "sent"],
                "type": "string"
              },
              "subtitle": {
                "maxLength": 2048,
                "type": "string"
              },
              "title": {
                "maxLength": 2048,
                "type": "string"
              },
              "updatedAt": {
                "type": "number"
              },
              "workspaceId": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "conversationId",
              "groupId",
              "id",
              "status",
              "subtitle",
              "title",
              "updatedAt",
              "workspaceId"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "CommaStatusMenuClientFrame": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "status-menu.ready",
              "type": "string"
            },
            "protocolVersion": {
              "const": 3,
              "type": "number"
            },
            "requestId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["kind", "protocolVersion", "requestId"],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "const": "status-menu.select",
              "type": "string"
            },
            "protocolVersion": {
              "const": 3,
              "type": "number"
            },
            "requestId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["id", "kind", "protocolVersion", "requestId"],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "type": "string"
            },
            "kind": {
              "const": "status-menu.result",
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "protocolVersion": {
              "const": 3,
              "type": "number"
            },
            "requestId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["kind", "ok", "protocolVersion", "requestId"],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "type": "string"
            },
            "expectedProtocolVersion": {
              "const": 3,
              "type": "number"
            },
            "frameKind": {
              "type": "string"
            },
            "kind": {
              "const": "status-menu.protocol-error",
              "type": "string"
            },
            "protocolVersion": {
              "const": 3,
              "type": "number"
            },
            "receivedProtocolVersion": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": ["error", "expectedProtocolVersion", "kind", "protocolVersion"],
          "type": "object"
        }
      ]
    },
    "CommaStatusMenuHostFrame": {
      "oneOf": [
        {
          "properties": {
            "closeId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "iconPath": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "const": "status-menu.show",
              "type": "string"
            },
            "openId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "protocolVersion": {
              "const": 3,
              "type": "number"
            },
            "requestId": {
              "minLength": 1,
              "type": "string"
            },
            "rows": {
              "items": {
                "properties": {
                  "detail": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "fraction": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "id": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "enum": ["header", "item", "separator", "meter"],
                    "type": "string"
                  },
                  "shortcut": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 1024,
                    "type": "string"
                  },
                  "tone": {
                    "enum": ["normal", "critical"],
                    "type": "string"
                  }
                },
                "required": ["kind"],
                "type": "object"
              },
              "maxItems": 64,
              "type": "array"
            },
            "toolTip": {
              "maxLength": 256,
              "type": "string"
            },
            "width": {
              "maximum": 1200,
              "minimum": 120,
              "type": "number"
            }
          },
          "required": [
            "iconPath",
            "kind",
            "rows",
            "toolTip",
            "width",
            "protocolVersion",
            "requestId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "status-menu.hide",
              "type": "string"
            },
            "protocolVersion": {
              "const": 3,
              "type": "number"
            },
            "requestId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["kind", "protocolVersion", "requestId"],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://comma.afk.surf/schemas/native-partner-contracts-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/CommaNotchScenePayload"
    },
    {
      "$ref": "#/$defs/CommaStatusMenuClientFrame"
    },
    {
      "$ref": "#/$defs/CommaStatusMenuHostFrame"
    }
  ],
  "title": "Comma native partner contracts",
  "x-comma-native-protocols": [
    {
      "direction": "main-to-native",
      "id": "notch.scene-payload",
      "schema": "#/$defs/CommaNotchScenePayload",
      "swiftType": "CommaNotchScenePayload"
    },
    {
      "direction": "native-to-main",
      "id": "status-menu.client-frame",
      "schema": "#/$defs/CommaStatusMenuClientFrame",
      "swiftType": "CommaStatusMenuClientFrame"
    },
    {
      "direction": "main-to-native",
      "id": "status-menu.host-frame",
      "schema": "#/$defs/CommaStatusMenuHostFrame",
      "swiftType": "CommaStatusMenuHostFrame"
    }
  ]
}
