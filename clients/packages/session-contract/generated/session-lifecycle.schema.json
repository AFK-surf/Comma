        "phase": { "type": "string", "const": "signed_in" },
        "principal": {
          "type": "object",
          "properties": {
            "displayName": { "type": "string", "minLength": 1, "maxLength": 512 },
            "email": { "type": "string", "minLength": 1, "maxLength": 320 },
            "kind": { "type": "string", "enum": ["guest", "registered"] },
            "userId": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "required": ["email", "userId"],
          "additionalProperties": false
        },
        "session": {
          "type": "object",
          "properties": {
            "audience": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "expiresAtEpochSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
