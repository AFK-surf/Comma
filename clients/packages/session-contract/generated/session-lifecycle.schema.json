{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "authority": {
          "type": "object",
          "properties": {
            "authorityInstanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "kind": {
              "type": "string",
              "enum": ["web_cookie", "electron_main", "swiftui_keychain"]
            }
          },
          "required": ["authorityInstanceId", "kind"],
          "additionalProperties": false
        },
        "cleanup": {
          "oneOf": [
            {
              "type": "object",
              "properties": { "revocation": { "type": "string", "const": "idle" } },
              "required": ["revocation"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "pendingCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "revocation": { "type": "string", "const": "pending" }
              },
              "required": ["pendingCount", "revocation"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": { "revocation": { "type": "string", "const": "unknown" } },
              "required": ["revocation"],
              "additionalProperties": false
            }
          ]
        },
        "contractVersion": { "type": "number", "const": 1 },
        "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "phase": {
          "type": "string",
          "enum": ["initializing", "authenticating", "signing_out", "invalidating"]
        },
        "principal": { "type": "null" },
        "session": { "type": "null" }
      },
      "required": [
        "authority",
        "cleanup",
        "contractVersion",
        "generation",
        "revision",
        "phase",
        "principal",
        "session"
      ],
      "additionalProperties": false
    },
    {
