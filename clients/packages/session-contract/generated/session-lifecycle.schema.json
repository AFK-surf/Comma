        "phase": { "type": "string", "const": "indeterminate" },
        "principal": { "type": "null" },
        "problem": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "session_probe_unavailable",
                "credential_store_unavailable",
                "credential_store_unreadable",
                "credential_mutation_uncertain",
                "protocol_mismatch"
              ]
            },
            "operation": {
              "type": "string",
              "enum": [
                "initialize",
                "authenticate",
                "reconcile",
                "sign_out",
                "invalidate"
              ]
            },
            "recovery": {
              "type": "string",
              "enum": [
                "none",
                "retry_operation",
                "reconcile",
                "new_auth_attempt",
                "after_host_change"
              ]
            },
            "retryable": { "type": "boolean" }
          },
          "required": ["code", "operation", "recovery", "retryable"],
          "additionalProperties": false
        },
        "session": { "type": "null" }
