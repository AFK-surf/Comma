{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "lib": ["ES2024", "DOM"],
    "outDir": "dist",
    "rootDir": "../..",
    "paths": {
      "@comma/native-bridge": ["../native-bridge/src/index.ts"],
      "@comma/session-contract": ["../session-contract/src/index.ts"]
    },
    "tsBuildInfoFile": "../../../node_modules/.tmp/tsconfig.session-history-runtime.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "../native-bridge/src/**/*.ts",
    "../session-contract/src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.spec.*",
    "../native-bridge/**/*.test.*",
    "../native-bridge/**/*.spec.*",
    "../session-contract/**/*.test.*",
    "../session-contract/**/*.spec.*"
  ]
}
