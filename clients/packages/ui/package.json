{
  "name": "@comma/ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "generate:css": "tsx ./scripts/generate-css.ts",
    "storybook": "pnpm generate:css && storybook dev -p 6006",
    "storybook:e2e": "pnpm generate:css && storybook dev --ci --no-open --exact-port -p 6011",
    "build-storybook": "pnpm generate:css && storybook build",
    "deploy:storybook:preview": "wrangler versions upload --config wrangler.jsonc --name \"$CLOUDFLARE_STORYBOOK_WORKER_NAME\"",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test-storybook": "pnpm generate:css && vitest run --project=storybook"
  },
  "dependencies": {
    "@central-icons-react/round-filled-radius-2-stroke-2": "^1.1.300",
    "@central-icons-react/round-outlined-radius-2-stroke-1.5": "^1.1.315",
    "@central-icons-react/round-outlined-radius-2-stroke-2": "^1.1.296",
    "@comma/i18n": "workspace:*",
    "@radix-ui/react-collapsible": "^1.1.14",
    "cmdk": "^1.1.1",
    "katex": "^0.16.47",
    "markstream-react": "0.0.52",
    "mermaid": "^11.15.0",
    "react": "^19.2.7",
    "react-aria": "^3.49.0",
    "react-aria-components": "^1.18.0",
    "shiki": "^3.23.0",
    "sonner": "^2.0.7",
    "stream-markdown": "^0.0.16",
    "stream-markdown-parser": "1.0.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@comma/layout-inspector": "workspace:*",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.1",
    "@tweakpane/core": "2.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.11",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "status-indicator": "github:zanwei/status-indicator-web-component#5dc7d9db6d04fee85b9376e2fb6575fdc079e5e9",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "tweakpane": "^4.0.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.101.0"
  }
}
