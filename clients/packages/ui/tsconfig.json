{
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../../node_modules/.tmp/tsconfig.ui.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@comma/core/markdown": ["../core/src/markdown/index.ts"],
      "@comma/i18n": ["../i18n/src/index.ts"],
      "@comma/i18n/react": ["../i18n/src/react.tsx"]
    },
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": ["**/*.test.*", "**/*.spec.*", "**/*.stories.*"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../i18n"
    }
  ]
}
