{
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../../node_modules/.tmp/tsconfig.ui.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "../..",
    "paths": {
      "@comma/i18n": ["../i18n/src/index.ts"],
      "@comma/i18n/react": ["../i18n/src/react.tsx"]
