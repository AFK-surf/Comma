{
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "schemaVersion": 42,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "gcm_datasource",
        "skipUrlSync": false,
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "label": "Cloud Monitoring datasource",
        "query": "stackdriver",
        "hide": 2
      },
      {
        "type": "query",
        "name": "gcp_project",
        "skipUrlSync": false,
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "label": "Cloud Monitoring project",
        "datasource": {
          "type": "stackdriver",
          "uid": "${gcm_datasource}"
        },
        "query": {
          "selectedQueryType": "projects",
          "projectName": ""
        },
        "refresh": 1,
        "hide": 2
      }
    ]
  },
  "annotations": {},
  "title": "Comma BFT",
  "uid": "comma-staging-bft",
  "description": "Bridge For Teams domain operations, read-cache, and sweeper signals. BFT metrics are lazy; workload scrape health is the required collection context.",
  "tags": [
    "comma",
    "generated",
    "staging",
    "bft"
  ],
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "id": 301,
      "title": "BFT workload scrape health",
      "description": "Required health for the comma workload that emits BFT metrics. No data is abnormal and is never synthesized as zero.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "min by (workload) (up{namespace=\"comma\",workload=\"comma\"})",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 310,
      "title": "BFT operation traffic",
      "description": "Lazy domain traffic by bounded operation, provider, and outcome. An empty window requires checking workload scrape health above.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}} {{operation}} {{provider}} {{outcome}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (workload, operation, provider, outcome) (rate(bft_operations_total{namespace=\"comma\",workload=\"comma\"}[5m]))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 311,
      "title": "BFT non-ok operations",
      "description": "Lazy non-ok outcomes. Read an empty result with operation traffic and the required workload scrape-health panel; it is not rendered as zero.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}} {{operation}} {{provider}} {{outcome}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (workload, operation, provider, outcome) (rate(bft_operations_total{namespace=\"comma\",workload=\"comma\",outcome!=\"ok\"}[5m]))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 312,
      "title": "BFT operation p95 latency",
      "description": "Lazy operation latency computed from histogram buckets. Missing series can mean no matching operations; verify traffic and scrape health.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}} {{operation}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "histogram_quantile(0.95, sum by (le, workload, operation) (rate(bft_operations_duration_seconds_bucket{namespace=\"comma\",workload=\"comma\"}[5m])))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 320,
      "title": "BFT read-cache request rate",
      "description": "Lazy cache demand by bounded result. No requests produce No data; check workload health before interpreting an empty window.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}} {{result}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (workload, result) (rate(bft_read_cache_requests_total{namespace=\"comma\",workload=\"comma\"}[5m]))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 321,
      "title": "BFT read-cache hit ratio",
      "description": "Lazy hit ratio over observed cache requests. An idle window remains No data instead of becoming a synthetic success value.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}} hit ratio",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (workload) (rate(bft_read_cache_requests_total{namespace=\"comma\",workload=\"comma\",result=\"hit\"}[5m])) / sum by (workload) (rate(bft_read_cache_requests_total{namespace=\"comma\",workload=\"comma\"}[5m]))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 330,
      "title": "BFT sweeper scanned rate",
      "description": "Lazy artifact and storage sweep work by operation and outcome. Empty results require workload-health context and do not imply a successful sweep.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}} {{operation}} {{outcome}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (workload, operation, outcome) (rate(bft_sweeper_scanned_total{namespace=\"comma\",workload=\"comma\"}[5m]))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "text",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "mode": "markdown",
        "content": "BFT metrics do not define a `surface` label. This dashboard preserves their real bounded dimensions and uses linked dashboards for shared or adjacent domain context.\n\n- [Platform Overview](/d/comma-staging-platform-overview) — workload, HTTP, runtime, database, and Kubernetes root-cause context\n- [Salix Runtime](/d/comma-staging-salix-runtime) — agent, VM, LLM, and reporting dependencies\n- [Billing](/d/comma-staging-billing) — billing operation and Stripe throttling context\n- [Telemetry contracts](https://github.com/AFK-surf/Comma/blob/main/docs/observability.md)"
      },
      "id": 340,
      "title": "Operational context",
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 8
      }
    }
  ]
}
