      "id": 412,
      "title": "Operation p95 latency",
      "description": "Histogram p95 for operations that occurred in the selected window.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{operation}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "histogram_quantile(0.95, sum by (le, workload, operation) (rate(comma_product_operations_duration_seconds_bucket{namespace=\"comma\",workload=\"comma\"}[5m])))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
