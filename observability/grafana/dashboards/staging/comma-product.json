          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (workload, operation, provider, outcome) (rate(comma_product_operations_total{namespace=\"comma\",workload=\"comma\",outcome!=\"ok\"}[5m]))",
            "step": "$__interval"
          }
        },
        {
          "refId": "B",
          "queryType": "promQL",
          "aliasBy": "{{workload}} scrape up",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "up{namespace=\"comma\",workload=\"comma\"}",
            "step": "$__interval"
          }
        }
      ]
    },
