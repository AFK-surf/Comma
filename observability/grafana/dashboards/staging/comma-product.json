      "id": 411,
      "title": "Non-ok operation rate",
      "description": "Lazy non-ok outcomes shown with scrape context; empty can mean no event.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{operation}} {{provider}} {{outcome}}",
