  "annotations": {},
  "title": "Comma Platform Overview",
  "uid": "comma-staging-platform-overview",
  "description": "Staging platform health and shared runtime signals, published by read-only Git Sync. No data on required health panels is abnormal.",
  "tags": [
    "comma",
    "generated",
    "staging",
    "platform"
  ],
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "id": 101,
      "title": "Application scrape health",
      "description": "Required health. Missing series is a collection failure and is never synthesized as zero.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "min by (workload) (up{namespace=\"comma\",job=\"comma\"})",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "stat",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "id": 102,
      "title": "Workload ready / desired",
      "description": "Required Kubernetes readiness. Compare ready and desired series; No data is abnormal.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}} ready",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "label_replace(kube_statefulset_status_replicas_ready{namespace=\"comma\",statefulset=\"comma\"}, \"workload\", \"$1\", \"statefulset\", \"(.*)\")",
            "step": "$__interval"
          }
        },
        {
          "refId": "B",
          "queryType": "promQL",
          "aliasBy": "{{workload}} desired",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "label_replace(kube_statefulset_replicas{namespace=\"comma\",statefulset=\"comma\"}, \"workload\", \"$1\", \"statefulset\", \"(.*)\")",
            "step": "$__interval"
          }
        }
      ]
