      "id": 151,
      "title": "IM ingress 5xx breach",
      "description": "HTTP-layer companion view for Cloud Monitoring policy comma_alerting:im_ingress_5xx (the alert itself evaluates the im_ingress operation metric). A point is the 15-minute 5xx ratio only when it exceeds 5% and the same window contains at least 20 requests. No data is not proof of health; check required scrape health and route traffic.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 37,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}} candidate breach",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "(((((sum by (workload) (increase(comma_system_http_requests_total{namespace=\"comma\",workload=\"comma\",route=\"/v1/im/*\",status_class=\"5xx\"}[15m]))) or on(workload) (0 * (sum by (workload) (increase(comma_system_http_requests_total{namespace=\"comma\",workload=\"comma\",route=\"/v1/im/*\"}[15m]))))) / (sum by (workload) (increase(comma_system_http_requests_total{namespace=\"comma\",workload=\"comma\",route=\"/v1/im/*\"}[15m])))) > 0.05) and on(workload) ((sum by (workload) (increase(comma_system_http_requests_total{namespace=\"comma\",workload=\"comma\",route=\"/v1/im/*\"}[15m]))) >= 20)) or on(workload) (0 * (sum by (workload) (increase(comma_system_http_requests_total{namespace=\"comma\",workload=\"comma\",route=\"/v1/im/*\"}[15m]))))",
            "step": "$__interval"
          }
        }
      ]
