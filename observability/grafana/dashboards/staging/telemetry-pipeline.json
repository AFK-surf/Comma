{
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "schemaVersion": 42,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "gcm_datasource",
        "skipUrlSync": false,
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "label": "Cloud Monitoring datasource",
        "query": "stackdriver",
        "hide": 2
      },
      {
        "type": "query",
        "name": "gcp_project",
        "skipUrlSync": false,
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "label": "Cloud Monitoring project",
        "datasource": {
          "type": "stackdriver",
          "uid": "${gcm_datasource}"
        },
        "query": {
          "selectedQueryType": "projects",
          "projectName": ""
        },
        "refresh": 1,
        "hide": 2
      }
    ]
  },
  "annotations": {},
  "title": "Comma Telemetry Pipeline",
  "uid": "comma-staging-telemetry-pipeline",
  "description": "Application scrape and trace-pipeline health. Cloud Monitoring invariant alerts remain the only page owner.",
  "tags": [
    "comma",
    "generated",
    "staging",
    "telemetry"
  ],
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "id": 201,
      "title": "Application targets",
      "description": "Required application scrape health, intentionally separate from Collector health.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{workload}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "min by (workload) (up{namespace=\"comma\",job=\"comma\"})",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "stat",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "id": 202,
      "title": "Collector targets",
      "description": "Required Collector scrape health. Healthy Collectors do not imply healthy application targets.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{pod}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "min by (pod) (up{namespace=\"comma\",job=\"comma-otel-collector\"})",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "stat",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "id": 203,
      "title": "Collector revision",
      "description": "Bounded rollout context for the Collector replicas.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{revision}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "count by (revision) (up{namespace=\"comma\",job=\"comma-otel-collector\"})",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 210,
      "title": "Receiver accepted spans",
      "description": "Per-instance receiver traffic; imbalance is expected with long-lived connections.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{pod}} {{receiver}}/{{transport}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (pod, receiver, transport) (rate({__name__=\"otelcol_receiver_accepted_spans__spans__total\",namespace=\"comma\"}[5m]))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 211,
      "title": "Receiver refused spans",
      "description": "Lazy failure series. Interpret an empty window with Collector up and accepted traffic; do not treat missing scrape data as healthy zero.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{pod}} refused",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (pod, receiver, transport) (rate({__name__=\"otelcol_receiver_refused_spans__spans__total\",namespace=\"comma\"}[5m]))",
            "step": "$__interval"
          }
        },
        {
          "refId": "B",
          "queryType": "promQL",
          "aliasBy": "{{pod}} scrape up",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "up{namespace=\"comma\",job=\"comma-otel-collector\"}",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 220,
      "title": "Exporter sent spans",
      "description": "Per-instance successful export attempts.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{pod}} {{exporter}}",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (pod, exporter) (rate({__name__=\"otelcol_exporter_sent_spans__spans__total\",namespace=\"comma\"}[5m]))",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 221,
      "title": "Exporter send failures",
      "description": "Lazy failure series shown with Collector scrape context. Cloud Monitoring owns paging.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{pod}} failed",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "sum by (pod, exporter) (rate({__name__=\"otelcol_exporter_send_failed_spans__spans__total\",namespace=\"comma\"}[5m]))",
            "step": "$__interval"
          }
        },
        {
          "refId": "B",
          "queryType": "promQL",
          "aliasBy": "{{pod}} scrape up",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "up{namespace=\"comma\",job=\"comma-otel-collector\"}",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "asc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 230,
      "title": "Exporter queue size / capacity",
      "description": "Required queue capacity and current size. No data is abnormal; values are not synthesized.",
      "datasource": {
        "type": "stackdriver",
        "uid": "${gcm_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "promQL",
          "aliasBy": "{{pod}} size",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "max by (pod, exporter, data_type) ({__name__=\"otelcol_exporter_queue_size__batches_\",namespace=\"comma\"})",
            "step": "$__interval"
          }
        },
        {
          "refId": "B",
          "queryType": "promQL",
          "aliasBy": "{{pod}} capacity",
          "datasource": {
            "type": "stackdriver",
            "uid": "${gcm_datasource}"
          },
          "timeSeriesList": {
            "projectName": "",
            "crossSeriesReducer": ""
          },
          "promQLQuery": {
            "projectName": "${gcp_project}",
            "expr": "max by (pod, exporter, data_type) ({__name__=\"otelcol_exporter_queue_capacity__batches_\",namespace=\"comma\"})",
            "step": "$__interval"
          }
        }
      ]
    },
    {
      "type": "text",
      "transparent": false,
      "repeatDirection": "h",
      "options": {
        "mode": "markdown",
        "content": "Required health No data means collection is missing; it is never rendered as zero.\n\nFailure counters are lazy. Read them with application/Collector `up` and traffic context.\n\n- [Platform telemetry runbook](https://github.com/AFK-surf/Comma/blob/main/docs/observability.md)\n- [Cloud Monitoring invariant alerts](https://github.com/AFK-surf/Comma/blob/main/k8s/comma/cloud-monitoring/README.md)\n- [Telemetry contracts](https://github.com/AFK-surf/Comma/blob/main/docs/observability.md)"
      },
      "id": 240,
      "title": "Semantics and runbooks",
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      }
    }
  ]
}
