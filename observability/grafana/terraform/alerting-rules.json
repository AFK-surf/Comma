    {
      "uid": "comma-stg-llm-error",
      "name": "[P2][STG][可用性] LLM 最终请求错误率持续过高",
      "condition": "C",
      "for": "15m",
      "no_data_state": "OK",
      "exec_err_state": "KeepLast",
      "is_paused": false,
      "labels": {
        "domain": "可用性",
        "environment": "staging",
        "priority": "P2",
        "source": "grafana",
        "team": "comma"
      },
      "annotations": {
        "__dashboardUid__": "comma-staging-salix-runtime",
        "__panelId__": "561",
        "summary": "Staging 的 LLM logical request 最终错误率持续偏高。",
        "description": "告警语义：部分 LLM logical request 可能在重试后仍失败，但不表示所有 provider 或模型不可用。 判定口径：15 分钟 logical request 数 >= 10 且最终错误率 > 10%，条件连续成立 15 分钟。",
        "impact": "部分 LLM logical request 可能在重试后仍失败，但不表示所有 provider 或模型不可用。",
        "evidence": "Grafana 在满足最低请求量后，持续观察到最终 outcome=error 的比例超过阈值。",
        "unknown": "尚未确认具体 provider、model、surface、受影响用户与根因。",
        "action": "先看 Grafana Panel，再在 Salix Runtime 对照 logical request、attempt 与 workload 维度。",
        "criteria": "15 分钟 logical request 数 >= 10 且最终错误率 > 10%，条件连续成立 15 分钟。",
        "policy_id": "comma_grafana:stg_llm_logical_error",
        "logs_url": "https://console.cloud.google.com/logs/query;query=resource.type%3D%22k8s_container%22%0Aresource.labels.namespace_name%3D%22comma%22?project=${GCP_PROJECT_ID}",
        "deployment_url": "https://github.com/AFK-surf/Comma/actions/workflows/comma-deployment.yml?query=branch%3Amain"
      },
      "data": [
        {
          "ref_id": "A",
          "query_type": "promQL",
          "relative_time_range": {
            "from": 1200,
            "to": 0
          },
          "datasource_uid": "${GCM_DATASOURCE_UID}",
          "model": {
            "datasource": {
              "type": "stackdriver",
              "uid": "${GCM_DATASOURCE_UID}"
            },
            "hide": false,
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "promQLQuery": {
              "expr": "(((((sum by (workload) (increase(salix_llm_requests_total{namespace=\"comma\",workload=\"comma\",outcome=\"error\"}[15m]))) or on(workload) (0 * (sum by (workload) (increase(salix_llm_requests_total{namespace=\"comma\",workload=\"comma\"}[15m]))))) / (sum by (workload) (increase(salix_llm_requests_total{namespace=\"comma\",workload=\"comma\"}[15m])))) > 0.1) and on(workload) ((sum by (workload) (increase(salix_llm_requests_total{namespace=\"comma\",workload=\"comma\"}[15m]))) >= 10)) or on(workload) (0 * (sum by (workload) (increase(salix_llm_requests_total{namespace=\"comma\",workload=\"comma\"}[15m]))))",
              "projectName": "${GCP_PROJECT_ID}",
              "step": "10s"
            },
            "queryType": "promQL",
            "refId": "A",
            "timeSeriesList": {
              "filters": [],
              "instant": true,
              "projectName": "${GCP_PROJECT_ID}",
              "view": "FULL"
            }
          }
        },
        {
          "ref_id": "reducer",
          "query_type": "expression",
          "relative_time_range": {
            "from": 0,
            "to": 0
          },
          "datasource_uid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0,
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": []
                },
                "reducer": {
                  "params": [],
                  "type": "avg"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "name": "Expression",
              "type": "__expr__",
              "uid": "-100"
            },
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "reducer",
            "type": "reduce"
          }
        },
        {
          "ref_id": "C",
          "query_type": "expression",
          "relative_time_range": {
            "from": 0,
            "to": 0
          },
          "datasource_uid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "-100"
            },
            "expression": "reducer",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ]
