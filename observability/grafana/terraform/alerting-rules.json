            },
            "hide": false,
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "promQLQuery": {
              "expr": "(((histogram_quantile(0.95, sum by (workload, le) (rate(salix_llm_ttft_seconds_bucket{namespace=\"comma\",workload=\"comma\"}[15m])))) > 30) and on(workload) ((sum by (workload) (increase(salix_llm_ttft_seconds_count{namespace=\"comma\",workload=\"comma\"}[15m]))) >= 20)) or on(workload) (0 * (sum by (workload) (increase(salix_llm_ttft_seconds_count{namespace=\"comma\",workload=\"comma\"}[15m]))))",
              "projectName": "${GCP_PROJECT_ID}",
