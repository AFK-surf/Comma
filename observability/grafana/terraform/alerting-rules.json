    {
      "uid": "comma-stg-meeting-delivery-error",
      "name": "[P2][STG][可用性] 会议总结投递持续报错",
      "condition": "C",
      "for": "15m",
      "no_data_state": "OK",
      "exec_err_state": "KeepLast",
      "is_paused": false,
      "labels": {
        "domain": "可用性",
