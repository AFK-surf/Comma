    {
      "uid": "bfsralwg6q1hcd",
      "name": "[P2][STG][容量] LLM TTFT p95 持续过高",
      "condition": "C",
      "for": "15m",
      "no_data_state": "OK",
      "exec_err_state": "KeepLast",
      "is_paused": false,
      "labels": {
        "domain": "容量",
