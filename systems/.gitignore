# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/
/apps/*/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Local runtime config may contain deployment secrets. Use
# config/config.example.json for committed examples.
/config.json

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Legacy local worker output dir.
/priv_build/

# Compiled dashboard output (assets + phx.digest cache_manifest.json),
# regenerated by `mix assets.build` / `assets.deploy`; only the sources under
# apps/bridge_for_teams_web/assets/ are tracked.
/apps/bridge_for_teams_web/priv/static/*
!/apps/bridge_for_teams_web/priv/static/images/
/apps/bridge_for_teams_web/priv/static/images/*
!/apps/bridge_for_teams_web/priv/static/images/bridge-icon-512.png

# Salix dashboard built output (regenerated by assets.build / assets.deploy);
# only the sources under apps/salix_web/assets/ and the static favicon/robots
# are tracked.
/apps/salix_web/priv/static/assets/*
/apps/salix_web/priv/static/cache_manifest.json

# Playwright dashboard e2e: deps + run artifacts.
/apps/bridge_for_teams_web/e2e/node_modules/
/apps/bridge_for_teams_web/e2e/test-results/
/apps/bridge_for_teams_web/e2e/playwright-report/
/apps/bridge_for_teams_web/e2e/.last-run.json
/apps/salix_web/e2e/node_modules/
/apps/salix_web/e2e/test-results/
/apps/salix_web/e2e/playwright-report/
/apps/salix_web/e2e/.last-run.json

# local dev overrides (never commit — may contain secrets)
config/compose-dev.local.json
docker-compose.local.yml

# Native spinfoam runtime (built by mix compile / the release image).
/apps/salix_agent/priv/spinfoam

# Per-app build dirs appear when mix runs inside an app directory.
/apps/*/_build/
