+
+// The embedded host decorates the selected transport without changing TLS or proxy policy.
+func observeSubscriptionTransport(ctx context.Context, client *http.Client) {
+	if wrap, ok := ctx.Value("salix.observe_transport").(func(http.RoundTripper) http.RoundTripper); ok {
+		rt := client.Transport
+		if rt == nil {
+			rt = http.DefaultTransport
+		}
+		client.Transport = wrap(rt)
+	}
+}
