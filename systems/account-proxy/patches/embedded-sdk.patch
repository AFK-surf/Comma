@@ -0,0 +1,33 @@
+package cliproxy
+
+import (
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	_ "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator/builtin"
+)
+
+// NewSubscriptionExecutor executes a host-selected credential without a Manager.
+// The host owns persistence, refresh coordination, and account selection.
+func NewSubscriptionExecutor(provider string) (auth.ProviderExecutor, error) {
+	cfg := &config.Config{DisableClaudeCloakMode: true}
+	switch provider {
+	case "codex":
+		return executor.NewCodexExecutor(cfg), nil
+	case "claude":
+		return executor.NewClaudeExecutor(cfg), nil
+	case "antigravity":
+		return executor.NewAntigravityExecutor(cfg), nil
+	case "xai":
+		return executor.NewXAIExecutor(cfg), nil
+	case "kimi":
+		return executor.NewKimiExecutor(cfg), nil
+	case "github-copilot":
+		// Copilot exposes an OpenAI-compatible API. The host supplies its
+		// short-lived token, base URL, and client headers as auth attributes.
+		return executor.NewOpenAICompatExecutor("github-copilot", cfg), nil
+	default:
+		return nil, fmt.Errorf("unsupported provider")
+	}
+}
diff --git a/sdk/oauth/subscription.go b/sdk/oauth/subscription.go
new file mode 100644
index 00000000..fa9c3514
--- /dev/null
+++ b/sdk/oauth/subscription.go
@@ -0,0 +1,95 @@
+// Package oauth exposes split-phase subscription enrollment without a callback listener.
+package oauth
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/claude"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+	sdkauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+// Attempt contains secrets. Persist it only in the host's credential store.
+type Attempt struct {
+	Provider  string `json:"provider"`
+	State     string `json:"state"`
+	Verifier  string `json:"verifier"`
+	Challenge string `json:"challenge"`
+	URL       string `json:"url"`
+}
+
+func Begin(cfg *config.Config, provider, state string) (*Attempt, error) {
+	a := &Attempt{Provider: provider, State: state}
+	switch provider {
+	case "codex":
+		p, err := codex.GeneratePKCECodes()
+		if err != nil {
+			return nil, err
+		}
+		a.Verifier, a.Challenge = p.CodeVerifier, p.CodeChallenge
+		a.URL, err = codex.NewCodexAuth(cfg).GenerateAuthURL(state, p)
+		return a, err
+	case "claude":
+		p, err := claude.GeneratePKCECodes()
+		if err != nil {
+			return nil, err
+		}
+		a.Verifier, a.Challenge = p.CodeVerifier, p.CodeChallenge
+		a.URL, _, err = claude.NewClaudeAuth(cfg).GenerateAuthURL(state, p)
+		return a, err
+	case "antigravity":
+		// Google's installed-app client uses its client secret, not PKCE.
+		a.URL = sdkauth.BuildAntigravityAuthURL(state, sdkauth.AntigravityDefaultCallbackURI())
+		return a, nil
+	default:
+		return nil, fmt.Errorf("unsupported provider")
+	}
+}
+
+// Exchange uses the original provider redirect and the attempt's PKCE verifier.
+// The host verifies tenant ownership, expiry, state, and single use before calling it.
+func Exchange(ctx context.Context, cfg *config.Config, a Attempt, code string) (map[string]any, error) {
+	var token any
+	var last string
+	var devices []string
+	switch a.Provider {
+	case "codex":
+		b, err := codex.NewCodexAuth(cfg).ExchangeCodeForTokens(ctx, code, &codex.PKCECodes{CodeVerifier: a.Verifier, CodeChallenge: a.Challenge})
+		if err != nil {
+			return nil, err
+		}
+		token, last = b.TokenData, b.LastRefresh
+	case "claude":
+		b, err := claude.NewClaudeAuth(cfg).ExchangeCodeForTokens(ctx, code, a.State, &claude.PKCECodes{CodeVerifier: a.Verifier, CodeChallenge: a.Challenge})
+		if err != nil {
+			return nil, err
+		}
+		token, last, devices = b.TokenData, b.LastRefresh, b.DeviceIDs
+	case "antigravity":
+		// Completion also resolves the account email and Cloud Code project.
+		r, err := sdkauth.CompleteAntigravityOAuth(ctx, code, sdkauth.AntigravityDefaultCallbackURI(), nil)
+		if err != nil {
+			return nil, err
+		}
+		token, last = r.Metadata, time.Now().UTC().Format(time.RFC3339)
+	default:
+		return nil, fmt.Errorf("unsupported provider")
+	}
+	data, err := json.Marshal(token)
+	if err != nil {
+		return nil, err
+	}
+	var metadata map[string]any
+	if err = json.Unmarshal(data, &metadata); err != nil {
+		return nil, err
+	}
+	metadata["type"], metadata["last_refresh"] = a.Provider, last
+	if len(devices) > 0 {
+		metadata["claude_device_ids"] = devices
+	}
+	return metadata, nil
+}
