+package cliproxy
+
+import (
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	_ "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator/builtin"
+)
+
+// NewSubscriptionExecutor executes a host-selected credential without a Manager.
+// The host owns persistence, refresh coordination, and account selection.
+func NewSubscriptionExecutor(provider string) (auth.ProviderExecutor, error) {
+	cfg := &config.Config{DisableClaudeCloakMode: true}
+	switch provider {
+	case "codex":
+		return executor.NewCodexExecutor(cfg), nil
+	case "claude":
+		return executor.NewClaudeExecutor(cfg), nil
+	default:
+		return nil, fmt.Errorf("unsupported provider")
+	}
+}
