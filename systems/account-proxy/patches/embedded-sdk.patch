@@ -0,0 +1,37 @@
+package oauth_test
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"net/url"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/oauth"
+)
+
+func TestSubscriptionEnrollmentKeepsPKCEAndProviderRedirect(t *testing.T) {
+	for provider, redirect := range map[string]string{"codex": "http://localhost:1455/auth/callback", "claude": "http://localhost:54545/callback"} {
+		t.Run(provider, func(t *testing.T) {
+			attempt, err := oauth.Begin(&config.Config{}, provider, "host-owned-state")
+			if err != nil {
+				t.Fatal(err)
+			}
+			u, err := url.Parse(attempt.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			q := u.Query()
+			if q.Get("state") != attempt.State || q.Get("redirect_uri") != redirect {
+				t.Fatal("authorization context changed")
+			}
+			hash := sha256.Sum256([]byte(attempt.Verifier))
+			if q.Get("code_challenge") != base64.RawURLEncoding.EncodeToString(hash[:]) {
+				t.Fatal("PKCE mismatch")
+			}
+			if q.Get("code_verifier") != "" {
+				t.Fatal("verifier leaked into browser URL")
