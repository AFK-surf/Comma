+package auth
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// SubscriptionModelRequest uses the host-selected model without the SDK's static
+// capability table. Subscription catalogs change independently of this SDK.
+// Keep the normal translation pipeline. The provider validates the requested effort.
+func SubscriptionModelRequest(req executor.Request) executor.Request {
+	return attachResolvedHomeModelInfo(req, nil, req.Model, &registry.ModelInfo{ID: req.Model, UserDefined: true}, nil)
+}
