+// BeginCodexDeviceAuthorization starts a split-phase device login for an embedded host.
+func BeginCodexDeviceAuthorization(ctx context.Context, cfg *config.Config) (string, string, int, error) {
+	client := util.SetProxy(&cfg.SDKConfig, &http.Client{})
+	result, err := requestCodexDeviceUserCode(ctx, client)
+	if err != nil {
+		return "", "", 0, err
+	}
+	code := strings.TrimSpace(result.UserCode)
+	if code == "" {
+		code = strings.TrimSpace(result.UserCodeAlt)
+	}
+	if code == "" || strings.TrimSpace(result.DeviceAuthID) == "" {
+		return "", "", 0, fmt.Errorf("missing device authorization fields")
+	}
+	return result.DeviceAuthID, code, int(parseCodexDevicePollInterval(result.Interval).Seconds()), nil
+}
+
+// PollCodexDeviceAuthorization checks once. The host owns the interval and expiry.
+func PollCodexDeviceAuthorization(ctx context.Context, cfg *config.Config, deviceAuthID, userCode string) (map[string]any, bool, error) {
+	client := util.SetProxy(&cfg.SDKConfig, &http.Client{})
+	result, err := pollCodexDeviceTokenOnce(ctx, client, deviceAuthID, userCode)
+	if err != nil {
+		return nil, false, err
+	}
+	if result == nil {
+		return nil, true, nil
+	}
+	if result.AuthorizationCode == "" || result.CodeVerifier == "" || result.CodeChallenge == "" {
+		return nil, false, fmt.Errorf("invalid device authorization response")
+	}
+
+	svc := codex.NewCodexAuth(cfg)
+	bundle, err := svc.ExchangeCodeForTokensWithRedirect(ctx, result.AuthorizationCode, codexDeviceTokenExchangeRedirectURI, &codex.PKCECodes{CodeVerifier: result.CodeVerifier, CodeChallenge: result.CodeChallenge})
+	if err != nil {
+		return nil, false, err
+	}
+	data, err := json.Marshal(bundle.TokenData)
+	if err != nil {
+		return nil, false, err
+	}
+	var metadata map[string]any
+	if err := json.Unmarshal(data, &metadata); err != nil {
+		return nil, false, err
+	}
+	metadata["type"], metadata["last_refresh"] = "codex", bundle.LastRefresh
+	return metadata, false, nil
+}
