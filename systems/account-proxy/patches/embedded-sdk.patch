diff --git a/sdk/auth/subscription_device.go b/sdk/auth/subscription_device.go
new file mode 100644
index 00000000..c4afa858
--- /dev/null
+++ b/sdk/auth/subscription_device.go
@@ -0,0 +1,131 @@
+package auth
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/kimi"
+	xaiauth "github.com/router-for-me/CLIProxyAPI/v8/internal/auth/xai"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+// DeviceAuthorization is the private split-phase device-login context.
+// It contains the device code. Persist it only in the host's credential store.
+type DeviceAuthorization struct {
+	DeviceCode      string `json:"device_code"`
+	UserCode        string `json:"user_code"`
+	VerificationURL string `json:"verification_url"`
+	Interval        int    `json:"interval"`
+	TokenEndpoint   string `json:"token_endpoint,omitempty"`
+	DeviceID        string `json:"device_id,omitempty"`
+}
+
+// DeviceStatus is the result of one provider check.
+type DeviceStatus string
+
+const (
+	DevicePending  DeviceStatus = "pending"
+	DeviceSlowDown DeviceStatus = "slow_down"
+	DeviceComplete DeviceStatus = "complete"
+)
+
+// BeginXAIDeviceAuthorization starts a split-phase xAI device login for an embedded host.
+func BeginXAIDeviceAuthorization(ctx context.Context, cfg *config.Config) (*DeviceAuthorization, error) {
+	code, err := xaiauth.NewXAIAuth(cfg).StartDeviceFlow(ctx)
+	if err != nil {
+		return nil, err
+	}
+	url := strings.TrimSpace(code.VerificationURIComplete)
+	if url == "" {
+		url = strings.TrimSpace(code.VerificationURI)
+	}
+	return &DeviceAuthorization{DeviceCode: code.DeviceCode, UserCode: code.UserCode, VerificationURL: url, Interval: code.Interval, TokenEndpoint: code.TokenEndpoint}, nil
+}
+
+// PollXAIDeviceAuthorization checks once. The host owns the interval and expiry.
+func PollXAIDeviceAuthorization(ctx context.Context, cfg *config.Config, d DeviceAuthorization) (map[string]any, DeviceStatus, error) {
+	endpoint, err := xaiauth.ValidateOAuthEndpoint(d.TokenEndpoint, "token_endpoint")
+	if err != nil {
+		return nil, "", err
+	}
+	svc := xaiauth.NewXAIAuth(cfg)
+	token, slowDown, err := svc.PollDeviceCodeOnce(ctx, endpoint, d.DeviceCode)
+	if err != nil {
+		return nil, "", err
+	}
+	if token == nil {
+		if slowDown {
+			return nil, DeviceSlowDown, nil
+		}
+		return nil, DevicePending, nil
+	}
+	s := svc.CreateTokenStorage(&xaiauth.AuthBundle{TokenData: *token, LastRefresh: time.Now().UTC().Format(time.RFC3339), BaseURL: xaiauth.DefaultAPIBaseURL, TokenEndpoint: endpoint})
+	metadata := map[string]any{
+		"type":           "xai",
+		"access_token":   s.AccessToken,
+		"refresh_token":  s.RefreshToken,
+		"id_token":       s.IDToken,
+		"token_type":     s.TokenType,
+		"expires_in":     s.ExpiresIn,
+		"expired":        s.Expire,
+		"last_refresh":   s.LastRefresh,
+		"base_url":       s.BaseURL,
+		"token_endpoint": s.TokenEndpoint,
+		"auth_kind":      "oauth",
+	}
+	if s.Email != "" {
+		metadata["email"] = s.Email
+	}
+	if s.Subject != "" {
+		metadata["sub"] = s.Subject
+	}
+	return metadata, DeviceComplete, nil
+}
+
+// BeginKimiDeviceAuthorization starts a split-phase Kimi Code device login.
+// The returned device ID must accompany every later poll for this attempt.
+func BeginKimiDeviceAuthorization(ctx context.Context, cfg *config.Config) (*DeviceAuthorization, error) {
+	client := kimi.NewDeviceFlowClientWithDomain(cfg, kimi.KimiDefaultDomain)
+	code, err := client.RequestDeviceCode(ctx)
+	if err != nil {
+		return nil, err
+	}
+	url := strings.TrimSpace(code.VerificationURIComplete)
+	if url == "" {
+		url = strings.TrimSpace(code.VerificationURI)
+	}
+	if strings.TrimSpace(code.DeviceCode) == "" || strings.TrimSpace(code.UserCode) == "" || url == "" {
+		return nil, fmt.Errorf("missing device authorization fields")
+	}
+	return &DeviceAuthorization{DeviceCode: code.DeviceCode, UserCode: code.UserCode, VerificationURL: url, Interval: code.Interval, DeviceID: client.DeviceID()}, nil
+}
+
+// PollKimiDeviceAuthorization checks once. The host owns the interval and expiry.
+func PollKimiDeviceAuthorization(ctx context.Context, cfg *config.Config, d DeviceAuthorization) (map[string]any, DeviceStatus, error) {
+	if strings.TrimSpace(d.DeviceID) == "" {
+		return nil, "", fmt.Errorf("missing device ID")
+	}
+	client := kimi.NewDeviceFlowClientWithDomainDeviceIDAndProxyURL(cfg, kimi.KimiDefaultDomain, d.DeviceID, "")
+	token, err := client.PollDeviceCodeOnce(ctx, d.DeviceCode)
+	if err != nil {
+		return nil, "", err
+	}
+	if token == nil {
+		return nil, DevicePending, nil
+	}
+	metadata := map[string]any{
+		"type":          "kimi",
+		"access_token":  token.AccessToken,
+		"refresh_token": token.RefreshToken,
+		"token_type":    token.TokenType,
+		"scope":         token.Scope,
+		"device_id":     client.DeviceID(),
+		"last_refresh":  time.Now().UTC().Format(time.RFC3339),
+	}
+	if token.ExpiresAt > 0 {
+		metadata["expired"] = time.Unix(token.ExpiresAt, 0).UTC().Format(time.RFC3339)
+	}
+	return metadata, DeviceComplete, nil
+}
