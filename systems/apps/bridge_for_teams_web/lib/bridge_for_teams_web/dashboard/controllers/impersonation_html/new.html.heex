<main class="min-h-screen bg-neutral-50 px-4 py-10">
  <div class="mx-auto max-w-lg rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
    <div class="mb-6">
      <h1 class="text-lg font-semibold tracking-tight text-neutral-900">{gettext("Impersonate user")}</h1>
      <p class="mt-1 text-sm text-neutral-500">
        {gettext("Switch your dashboard session to another Bridge For Teams user.")}
      </p>
    </div>

    <p :if={@error} class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
      {@error}
    </p>

    <.form :let={f} for={%{}} as={:impersonate} action={~p"/impersonate"} method="post">
      <div class="space-y-4">
        <.input
          field={f[:target]}
          label={gettext("Email or user ID")}
          value={@query}
          placeholder="person@example.com"
          required
        />
      </div>

      <div class="mt-6 flex items-center justify-end gap-2">
        <.link navigate={~p"/"} class="rounded-md px-3 py-2 text-sm font-medium text-neutral-600 hover:bg-neutral-100">
          {gettext("Cancel")}
        </.link>
        <.button type="submit" variant="primary">{gettext("Impersonate")}</.button>
      </div>
    </.form>
  </div>
</main>
