<%!-- OAuth terminal page — rendered ONLY when a safe redirect back to the client is impossible --%>
<%!-- (handle consumed/expired, redirect_uri validation failed, replayed POST). Normal denial 302s back with error=access_denied. --%>
<%!-- NO links or buttons here — the authorize endpoint must never offer a fallback redirect (RFC §6.4). --%>
<%!-- Assigns: @icon in :expired / :invalid / :denied / :error, plus @title, @body, @error_code set in the controller. --%>
<%!-- Classic EEx does NOT auto-escape: assigns are escaped by render_error/1 before reaching this template. --%>
<%!-- Copy table ({app} = escaped client display name, "the app" when unknown; :invalid NEVER renders the client name): --%>
<%!--  :expired  This sign-in request expired | Sign-in requests only stay valid for a few minutes. Go back to {app} and start signing in again. | authorization_request_expired --%>
<%!--  :invalid  This sign-in request isn’t valid | The app sent an invalid sign-in request. Go back and try again — if this keeps happening, contact the app’s developer. | invalid_request --%>
<%!--  :denied   Sign-in canceled | Nothing was shared with {app}. You can close this tab. | access_denied --%>
<%!--  :error    Something went wrong | Comma couldn’t process this sign-in. Go back to {app} and try again in a moment. | server_error --%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="referrer" content="no-referrer">
<title>Sign in with Comma</title>
<style>
:root{color-scheme:light dark;
 --bg:#ffffff;--fg:#1a1b1e;--fg-tertiary:#7f8286;--body-fg:#5b5e63;
 --chip-bg:#f5f5f5;--code-fg:#b6b8bb}
@media (prefers-color-scheme:dark){:root{
 --bg:#0f0f10;--fg:#f6f6f6;--fg-tertiary:#a4a5a9;--body-fg:#a4a5a9;
 --chip-bg:#27282b;--code-fg:#54565a}}
*{box-sizing:border-box}
body{margin:0;min-height:100dvh;display:flex;align-items:center;justify-content:center;
 padding:32px 16px;background:var(--bg);color:var(--fg);
 font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
 -webkit-font-smoothing:antialiased}
.col{width:360px;max-width:100%;display:flex;flex-direction:column;align-items:center}
.brandline{display:flex;align-items:center;gap:7px;color:var(--fg-tertiary);font-size:12px;font-weight:500;line-height:1}
.brandline svg{width:16px;height:16px;color:var(--fg)}
.status{margin-top:26px;width:48px;height:48px;border-radius:14px;background:var(--chip-bg);
 display:flex;align-items:center;justify-content:center;color:var(--fg-tertiary)}
.status svg{width:22px;height:22px}
h1{margin:16px 0 0;font-size:20px;line-height:30px;font-weight:500;letter-spacing:-.01em;text-align:center}
.body{margin:6px 0 0;font-size:13px;line-height:20px;color:var(--body-fg);text-align:center;max-width:300px;text-wrap:pretty}
.code{margin-top:22px;font-size:11px;font-weight:500;color:var(--code-fg);font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
</style>
</head>
<body>
<main class="col">
  <div class="brandline">
    <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24.0293 4.44182C35.2292 4.44193 44.3086 13.5212 44.3086 24.7211C44.3086 26.2292 44.141 27.698 43.8271 29.1117C43.7274 29.5609 43.0935 29.5949 42.8828 29.186C41.9591 27.3916 40.5289 25.8315 38.6514 24.7475C33.4379 21.7378 26.7689 23.5256 23.7588 28.7387C20.7499 33.9519 22.5373 40.6193 27.75 43.6293C27.798 43.657 27.8462 43.6845 27.8945 43.7113C28.2968 43.9348 28.2441 44.5646 27.792 44.6498C26.5728 44.8795 25.3151 45.0004 24.0293 45.0004C12.8294 45.0004 3.75017 35.9209 3.75 24.7211C3.75001 13.5212 12.8293 4.44182 24.0293 4.44182ZM27.5752 30.475C29.5842 26.9956 34.0342 25.803 37.5137 27.8119C40.8501 29.7385 42.081 33.9084 40.4053 37.3158C40.4099 37.3203 40.4144 37.3251 40.4189 37.3295C40.3568 37.4447 40.2857 37.5685 40.2051 37.6977C40.1952 37.715 40.1858 37.7331 40.1758 37.7504C39.7991 38.4028 39.3363 38.9749 38.8105 39.4604C37.1152 41.2376 34.3055 43.2112 30.4131 43.7602C30.2618 43.7814 30.1769 43.5981 30.29 43.4955C30.9997 42.8536 31.8303 42.0905 32.6543 41.2846C31.8262 41.1437 31.0084 40.8571 30.2383 40.4125C26.7589 38.4036 25.5665 33.9545 27.5752 30.475Z" fill="currentColor"/></svg>
    <span>Sign in with Comma</span>
  </div>
  <div class="status" aria-hidden="true">
    <%= case @icon do %>
    <% :expired -> %><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.6V12l3 1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <% :invalid -> %><svg viewBox="0 0 24 24" fill="none"><path d="M12 4l8.5 14.5h-17L12 4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 10v3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="16.2" r="0.9" fill="currentColor"/></svg>
    <% :denied -> %><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.6"/><path d="M6.6 6.6l10.8 10.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <% :error -> %><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.6"/><path d="M12 8v4.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="15.8" r="0.9" fill="currentColor"/></svg>
    <% end %>
  </div>
  <h1><%= @title %></h1>
  <p class="body"><%= @body %></p>
  <div class="code"><%= @error_code %></div>
</main>
</body>
</html>
