    "metric: {metrics?: [{label, value (display text), unit?, delta?, caption?, series?: [number] (<= 64)}] (<= 4), goal?: {current: number, target: number, valueLabel, targetLabel, note?}}; needs metrics or goal; layouts: single (1 metric), grid (2 to 4), goal",
    "trend: {brand?, value?, delta?, ranges?: [{key, label, points: [number] (2 to 64), axis: [text] (<= 6)}] (<= 4), bars?: {labels: [text] (1 to 31), values: [number] (1 to 31), valueLabels?: [text] (<= 31), averageLabel?}, series?: [{label, value, points: [number] (2 to 64), brand?, delta?}] (<= 6)}; needs ranges, bars or series; bars.labels has as many entries as bars.values; layouts: area (ranges), bars, watchlist (series)",
    "comparison: {subjects: [{name, caption?, recommended?: boolean, brand?}] (2 to 3), rows: [{label, values: [text or null] (<= 3; one per subject; null shows a dash), best?: integer >= 0 (subject index), scores?: [number from 0 to 10] (2 entries)}] (1 to 8), verdict?}; rows[].values has as many entries as subjects; layouts: columns, table (<= 4 rows), versus (2 subjects, scores on every row)",
    "schedule: {now?, events?: [{start, title, end?, detail?, state?, tone?}] (<= 8), stages?: [{label, state, detail?}] (2 to 6), summary?}; needs events or stages; layouts: agenda and timeline (events), stages",
    "checklist: {groups: [{label?, items: [{label, id?, detail?, done?: boolean}] (>= 1)}] (1 to 4; at most 12 items in total)}; layouts: progress, grouped (2 or more groups)",
    "composition: {total, totalLabel?, segments: [{label, value: number >= 0, valueLabel?, muted?: boolean}] (1 to 6)}; layouts: stacked, donut",
    "place: {places: [{name, category?, rating?: number, reviews?, status?, address?, distance?, eta?, href?: url}] (1 to 5)}; layouts: single (1 place), nearby (2 or more)",
