    "Fields are text unless a type follows the name. ? marks an optional field.",
    "Every kind accepts {title, meta? (short header context), source?, sourceBrand?, updatedAt? (display text such as \"17:05\"), actions?: [{label, prompt}] (<= 2; a click proposes the prompt like comma.request)}.",
    "tone: neutral | brand | success | warning | error",
    "condition: clear | clear-night | partly-cloudy | cloudy | rain | snow",
    "state: done | current | upcoming",
    "status: {label, tone?}",
    "delta: {value, direction?: up | down | flat, good?: boolean (true when the change is good)}",
    "url: an HTTPS URL",
    "forecast: {location?, current?: {temperature: number, condition?, label?, feelsLike?: number, humidity?: number (percent), wind?}, days?: [{label, condition, conditionLabel, high: number, low: number, precipitation?: number (percent)}] (<= 7), highlight?}; needs days or current; layouts: today (needs current), week, compact (current and <= 2 days)",
