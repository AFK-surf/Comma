// What a LAN script sees besides the language (docs/lan-script.md),
// built on the host functions of lan_script.c. Bytes are base64 strings throughout, as in the
// Connector's own methods. One JavaScript line per C line, so an error's line number reads here.
static const char LAN_SCRIPT_PRELUDE[] =
    "var lan = {\n"
    "  http: function (request) {\n"
    "    return JSON.parse(__lan(\"http_request\", JSON.stringify(request)));\n"
    "  },\n"
    "  udp: function (request) {\n"
    "    return JSON.parse(__lan(\"udp_request\", JSON.stringify(request)));\n"
    "  },\n"
    "  tcp: function (request) {\n"
    "    return JSON.parse(__lan(\"tcp_request\", JSON.stringify(request)));\n"
    "  },\n"
    "  discover: function (request) {\n"
    "    return JSON.parse(__lan(\"lan_discover\", JSON.stringify(request || {})));\n"
    "  }\n"
    "};\n"
    "var bytes = {\n"
    "  fromText: function (text) { return __bytes(\"fromText\", String(text)); },\n"
    "  toText: function (data) { return __bytes(\"toText\", data); },\n"
    "  fromHex: function (hex) { return __bytes(\"fromHex\", hex); },\n"
    "  toHex: function (data) { return __bytes(\"toHex\", data); },\n"
    "  fromArray: function (array) {\n"
    "    var hex = \"\";\n"
    "    for (var i = 0; i < array.length; i++) {\n"
    "      var n = array[i] & 255;\n"
    "      hex += (n < 16 ? \"0\" : \"\") + n.toString(16);\n"
    "    }\n"
    "    return __bytes(\"fromHex\", hex);\n"
    "  },\n"
    "  toArray: function (data) {\n"
    "    var hex = __bytes(\"toHex\", data), array = [];\n"
    "    for (var i = 0; i < hex.length; i += 2) array.push(parseInt(hex.substring(i, i + 2), 16));\n"
    "    return array;\n"
    "  },\n"
    "  concat: function (list) {\n"
    "    var out = \"\";\n"
    "    for (var i = 0; i < list.length; i++) out = __bytes(\"concat\", out, list[i]);\n"
    "    return out;\n"
    "  },\n"
    "  slice: function (data, start, end) { return __bytes(\"slice\", data, start, end); },\n"
    "  length: function (data) { return __bytes(\"length\", data); }\n"
    "};\n"
    "function __pad(data) {\n"
    "  var n = 16 - bytes.length(data) % 16, fill = [];\n"
    "  for (var i = 0; i < n; i++) fill.push(n);\n"
    "  return __bytes(\"concat\", data, bytes.fromArray(fill));\n"
    "}\n"
    "function __unpad(data) {\n"
    "  var length = bytes.length(data);\n"
    "  var tail = length > 0 ? bytes.toArray(bytes.slice(data, length > 16 ? length - 16 : 0)) : [];\n"
    "  var n = tail.length > 0 ? tail[tail.length - 1] : 0;\n"
    "  if (n < 1 || n > 16 || n > tail.length) throw new Error(\"bad PKCS#7 padding\");\n"
    "  for (var i = tail.length - n; i < tail.length; i++) if (tail[i] !== n) throw new Error(\"bad PKCS#7 padding\");\n"
    "  return bytes.slice(data, 0, length - n);\n"
    "}\n"
    "function __cipher(options, encrypt) {\n"
    "  var mode = options.mode, padding = options.padding || \"none\";\n"
    "  if (mode !== \"ecb\" && mode !== \"cbc\" && mode !== \"gcm\") throw new TypeError(\"mode must be ecb, cbc or gcm\");\n"
    "  if (padding !== \"none\" && padding !== \"pkcs7\") throw new TypeError(\"padding must be none or pkcs7\");\n"
    "  if (mode === \"gcm\" && padding !== \"none\") throw new TypeError(\"gcm takes no padding\");\n"
    "  var data = encrypt && padding === \"pkcs7\" ? __pad(options.data) : options.data;\n"
    "  var out = __aes(mode, encrypt, options.key, options.iv, data, options.aad, options.tag);\n"
    "  if (mode === \"gcm\" && encrypt) {\n"
    "    var at = out.indexOf(\":\");\n"
    "    return { data: out.substring(0, at), tag: out.substring(at + 1) };\n"
    "  }\n"
    "  return !encrypt && padding === \"pkcs7\" ? __unpad(out) : out;\n"
    "}\n"
    "var crypto = {\n"
    "  encrypt: function (options) { return __cipher(options, true); },\n"
    "  decrypt: function (options) { return __cipher(options, false); },\n"
    "  hash: function (algorithm, data) { return __hash(algorithm, data); },\n"
    "  hmac: function (algorithm, key, data) { return __hmac(algorithm, key, data); },\n"
    "  randomBytes: function (n) { return __random(n); }\n"
    "};\n"
    "function sleep(ms) { __sleep(ms); }\n"
    "function __text(value) {\n"
    "  if (typeof value === \"string\") return value;\n"
    "  if (value instanceof Error) return String(value);\n"
    "  var json = JSON.stringify(value);\n"
    "  return json === undefined ? String(value) : json;\n"
    "}\n"
    "var console = {\n"
    "  log: function () {\n"
    "    var parts = [];\n"
    "    for (var i = 0; i < arguments.length; i++) parts.push(__text(arguments[i]));\n"
    "    __log(parts.join(\" \"));\n"
    "  }\n"
    "};\n"
    "function __run(main, args) {\n"
    "  var json = JSON.stringify(main(JSON.parse(args)));\n"
    "  return json === undefined ? \"null\" : json;\n"
    "}\n";
